#include "BluetoothSerial.h"

BluetoothSerial SerialBT;

char receivedChar;

// SENSOR ULTRASÓNICO
#define TRIG 5
#define ECHO 18

// RELÉ
#define RELE 2

long duracion;
int distancia;

// Estado del relé
bool estadoRele = false;

void setup() {

  Serial.begin(9600);

  // Nombre Bluetooth
  SerialBT.begin("LED BLUE");

  // Pines del ultrasónico
  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);

  // Pin del relé
  pinMode(RELE, OUTPUT);

  digitalWrite(RELE, LOW);
}

void loop() {

  // ===== SENSOR ULTRASÓNICO =====

  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG, LOW);

  duracion = pulseIn(ECHO, HIGH);

  distancia = duracion * 0.034 / 2;

  Serial.print("Distancia: ");
  Serial.println(distancia);

  // Enviar distancia al celular
  SerialBT.print(distancia);
  SerialBT.print(";");

  // ===== CONTROL AUTOMÁTICO =====

  if (distancia < 15) {

    estadoRele = true;

  } else {

    estadoRele = false;
  }

  // ===== CONTROL MANUAL POR BLUETOOTH =====

  if (SerialBT.available()) {

    receivedChar = SerialBT.read();

    if (receivedChar == '1') {

      estadoRele = !estadoRele;
    }
  }

  // Aplicar estado al relé
  digitalWrite(RELE, estadoRele);

  delay(500);
}
