void setup() {

  Serial.begin(115200);

  // Encender luz TFT
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);

  // Iniciar SPI
  lcdSPI.begin(TFT_SCLK, TFT_MISO, TFT_MOSI, TFT_CS);

  // Iniciar pantalla
  tft.init(240, 320);

  // Rotación
  tft.setRotation(1);

  // Fondo negro
  tft.fillScreen(ST77XX_BLACK);

  // Mostrar imagen
  tft.drawRGBBitmap(0, 0, logo_565, 320, 240);

  Serial.println("Imagen mostrada");
}

